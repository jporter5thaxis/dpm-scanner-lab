# Optional lab login token. An empty value enables the password-free LAN lab.
# Production integration must retain the host application's authentication.
DPM_TOKEN=

# Optional writable directory for settings, SQLite, captures and logs.
# DPM_DATA=/absolute/path/to/private/scanner-data

# Linux service enables this itself. Requires supported Landlock and device access.
# DPM_RESTRICT_WRITES=1
